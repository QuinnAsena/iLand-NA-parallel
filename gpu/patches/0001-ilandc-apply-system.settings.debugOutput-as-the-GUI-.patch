From 368f6a85a803e2f75c3a8a848ad5b34b11cb1028 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 06:48:30 +1300
Subject: [PATCH 1/3] ilandc: apply system.settings.debugOutput, as the GUI
 does

The console version never passed the debugOutput flags to GlobalSettings,
so e.g. the per-year performance table (512) was never written.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F4XU94RLz4kFVSs5LcJjTK
---
 src/ilandc/consoleshell.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/ilandc/consoleshell.cpp b/src/ilandc/consoleshell.cpp
index 845b206..1273baa 100644
--- a/src/ilandc/consoleshell.cpp
+++ b/src/ilandc/consoleshell.cpp
@@ -129,7 +129,13 @@ void ConsoleShell::run()
         qWarning() << "*** creating model...";
         qWarning() << "**************************************************";
 
+        // apply the debug output flags (e.g. 512 = per-year performance table), as the GUI does
+        GlobalSettings::instance()->setDebugOutput((int) GlobalSettings::instance()->settings().valueDouble("system.settings.debugOutput"));
+
         iland_model.create();
+#ifdef ILAND_CUDA
+        qWarning() << QString::fromStdString(ilandgpu::description());
+#endif
         if (iland_model.hasError()) {
             qWarning() << "!!!! ERROR !!!!";
             qWarning() << iland_model.lastError();
-- 
